<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>


<VBox spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.NotaController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Encabezado -->
    <HBox spacing="15" alignment="CENTER_LEFT">

        <Label fx:id="lblTitulo"
               HBox.hgrow="ALWAYS"
               style="-fx-font-size: 32px; -fx-font-weight: bold;" />
               
		<Region HBox.hgrow="ALWAYS"/>
		
        <Button text="Editar"
                onAction="#editarNota"/>

        <Button text="Eliminar"
                onAction="#eliminarNota"/>
    </HBox>

    <!-- Contenido -->
    <TextArea fx:id="txtContenido"
              editable="false"
              wrapText="true"
              style="-fx-font-size: 16px;"
              prefHeight="400"/>

    <!-- Fechas -->
    <VBox spacing="5">
        <Label fx:id="lblFechaCreacion"
               style="-fx-text-fill: gray; -fx-font-size: 12px;" />

        <Label fx:id="lblFechaEdicion"
               style="-fx-text-fill: gray; -fx-font-size: 12px;" />
    </VBox>

</VBox>
