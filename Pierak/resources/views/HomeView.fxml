<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox 
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="controllers.HomeController"
    spacing="20"
    
>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Barra superior -->
    <HBox spacing="20" alignment="CENTER">
        <Button text="+ Nota" onAction="#crearNota" prefWidth="170" prefHeight="85" styleClass="button-home" />
        <Button text="+ Sección" onAction="#crearSeccion" prefWidth="170" prefHeight="85" styleClass="button-home" />
    </HBox>

    <!-- Grilla de secciones -->
    <ScrollPane fitToWidth="true">
        <GridPane
            fx:id="gridSecciones"
            alignment="CENTER"
            hgap="20"
            vgap="20"
        />
    </ScrollPane>

</VBox>
