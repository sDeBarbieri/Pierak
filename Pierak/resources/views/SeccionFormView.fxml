<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox spacing="20"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.SeccionFormController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Título -->
    <Label fx:id="lblTitulo"
           text="Nueva Sección"
           style="-fx-font-size: 28px; -fx-font-weight: bold;" />

    <!-- Nombre -->
    <VBox spacing="5">
        <Label text="Nombre de la sección"/>
        <TextField fx:id="txtNombre"
                   promptText="Ej: Ideas, Trabajo, Personal"/>
    </VBox>

    <!-- Acciones -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar"/>
        <Button text="Guardar" onAction="#guardarSeccion"/>
    </HBox>

</VBox>
